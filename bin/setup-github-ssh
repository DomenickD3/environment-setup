#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: setup-github-ssh [options]

Options:
  --email EMAIL       Key comment override. Default: github-ssh-$USER@$(hostname).
  --key-name NAME     Filename under ~/.ssh. Default: id_ed25519_github.
  --type TYPE         ed25519 or rsa. Default: ed25519.
  --no-agent          Skip starting ssh-agent and adding the key.
  --force             Allow overwriting an existing private key.
  -h, --help          Show this help.
USAGE
}

prompt_yes_no() {
  local prompt="$1"
  local reply

  read -r -p "$prompt [y/N] " reply
  case "$reply" in
    y|Y|yes|YES|Yes) return 0 ;;
    *) return 1 ;;
  esac
}

default_key_comment() {
  printf "github-ssh-%s@%s\n" "${USER:-user}" "$(hostname)"
}

normalize_public_key() {
  awk '{print $1 " " $2}' "$1"
}

ensure_github_ssh_config() {
  local private_key_path="$1"
  local config_path="$ssh_dir/config"
  local temp_config
  local identity_file

  identity_file="${private_key_path/#$HOME/\~}"
  temp_config="$(mktemp)"

  if [[ -e "$config_path" ]]; then
    awk '
      /^# BEGIN environment-setup github ssh$/ { skip = 1; next }
      /^# END environment-setup github ssh$/ { skip = 0; next }
      skip != 1 { print }
    ' "$config_path" > "$temp_config"
  fi

  {
    cat <<EOF
# BEGIN environment-setup github ssh
Host github.com
  HostName github.com
  User git
  IdentityFile $identity_file
  IdentitiesOnly yes
# END environment-setup github ssh
EOF
    if [[ -s "$temp_config" ]]; then
      printf "\n"
      cat "$temp_config"
    fi
  } > "$config_path"

  rm -f "$temp_config"
  chmod 600 "$config_path"
  echo "Configured SSH to use $private_key_path for github.com."
}

github_has_key() {
  local public_key_path="$1"
  local public_key
  local github_key
  local github_keys

  command -v gh >/dev/null 2>&1 || return 1
  gh auth status >/dev/null 2>&1 || return 1

  public_key="$(normalize_public_key "$public_key_path")"

  if ! github_keys="$(gh ssh-key list --json key --jq '.[].key')"; then
    return 1
  fi

  while IFS= read -r github_key; do
    [[ -n "$github_key" ]] || continue
    if [[ "$(awk '{print $1 " " $2}' <<<"$github_key")" == "$public_key" ]]; then
      return 0
    fi
  done <<<"$github_keys"

  return 1
}

ensure_github_public_key_scope() {
  command -v gh >/dev/null 2>&1 || return 1
  gh auth status >/dev/null 2>&1 || return 1

  if gh ssh-key list --json key --jq '.[].key' >/dev/null 2>&1; then
    return 0
  fi

  echo "Refreshing GitHub CLI auth scope for SSH key management..."
  gh auth refresh -h github.com -s admin:public_key
}

agent_has_key() {
  local fingerprint="$1"
  local loaded_key

  command -v ssh-add >/dev/null 2>&1 || return 1
  ssh-add -l >/dev/null 2>&1 || return 1

  while IFS= read -r loaded_key; do
    [[ -n "$loaded_key" ]] || continue
    if [[ "$(awk '{print $2}' <<<"$loaded_key")" == "$fingerprint" ]]; then
      return 0
    fi
  done < <(ssh-add -l)

  return 1
}

github_ssh_auth_succeeds() {
  local private_key_path="${1:-}"
  local ssh_output
  local -a ssh_options

  ssh_options=(-o BatchMode=yes -o StrictHostKeyChecking=accept-new)
  if [[ -n "$private_key_path" ]]; then
    ssh_options+=(-o IdentitiesOnly=yes -i "$private_key_path")
  fi

  set +e
  ssh_output="$(ssh "${ssh_options[@]}" -T git@github.com 2>&1)"
  set -e

  grep -q "successfully authenticated" <<<"$ssh_output"
}

test_github_ssh() {
  local private_key_path="${1:-}"
  local ssh_output
  local ssh_status
  local -a ssh_options

  echo
  echo "Testing GitHub SSH authentication..."

  ssh_options=(-o BatchMode=yes -o StrictHostKeyChecking=accept-new)
  if [[ -n "$private_key_path" ]]; then
    ssh_options+=(-o IdentitiesOnly=yes -i "$private_key_path")
  fi

  set +e
  ssh_output="$(ssh "${ssh_options[@]}" -T git@github.com 2>&1)"
  ssh_status=$?
  set -e

  if grep -q "successfully authenticated" <<<"$ssh_output"; then
    echo "$ssh_output"
    return 0
  fi

  echo "$ssh_output" >&2
  echo "GitHub SSH authentication test failed." >&2
  return "$ssh_status"
}

ensure_github_key() {
  local public_key_path="$1"
  local title="$2"
  local private_key_path="$3"

  command -v gh >/dev/null 2>&1 || return 0

  if ! gh auth status >/dev/null 2>&1; then
    echo "GitHub CLI is installed but not authenticated."
    if prompt_yes_no "Log in to GitHub now so I can add the public key automatically?"; then
      gh auth login --hostname github.com --git-protocol ssh --web
    else
      return 0
    fi
  fi

  ensure_github_public_key_scope

  if github_has_key "$public_key_path"; then
    echo "GitHub already has this SSH key."
    return 0
  fi

  if github_ssh_auth_succeeds "$private_key_path"; then
    echo "This SSH key already authenticates with GitHub."
    return 0
  fi

  if prompt_yes_no "Add this public key to GitHub now?"; then
    gh ssh-key add "$public_key_path" --title "$title"
  fi
}

email=""
key_name="id_ed25519_github"
key_type="ed25519"
use_agent=1
force=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --email)
      email="${2:-}"
      shift 2
      ;;
    --key-name)
      key_name="${2:-}"
      shift 2
      ;;
    --type)
      key_type="${2:-}"
      shift 2
      ;;
    --no-agent)
      use_agent=0
      shift
      ;;
    --force)
      force=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ "$key_name" == */* ]]; then
  echo "--key-name must be a filename, not a path." >&2
  exit 2
fi

missing_commands=()
required_commands=(ssh-keygen)
if [[ "$use_agent" -eq 1 ]]; then
  required_commands+=(ssh-agent ssh-add)
fi

for command_name in "${required_commands[@]}"; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    missing_commands+=("$command_name")
  fi
done

if [[ "${#missing_commands[@]}" -gt 0 ]]; then
  echo "Missing required command(s): ${missing_commands[*]}" >&2
  echo "Install OpenSSH client tools, then rerun this script." >&2
  echo "Ubuntu/Debian: sudo apt install openssh-client" >&2
  echo "Fedora: sudo dnf install openssh-clients" >&2
  echo "macOS: xcode-select --install" >&2
  exit 1
fi

ssh_dir="$HOME/.ssh"
key_path="$ssh_dir/$key_name"
public_key_path="$key_path.pub"
key_exists=0

if [[ -e "$key_path" && "$force" -ne 1 ]]; then
  key_exists=1
fi

if [[ "$key_exists" -ne 1 && -z "$email" ]]; then
  email="${GITHUB_SSH_KEY_EMAIL:-${GITHUB_NOREPLY_EMAIL:-}}"
  email="${email:-$(default_key_comment)}"
fi

mkdir -p "$ssh_dir"
chmod 700 "$ssh_dir"

if [[ -e "$key_path" && "$force" -eq 1 ]]; then
  rm -f "$key_path" "$public_key_path"
fi

if [[ -e "$key_path" ]]; then
  echo "Reusing existing key: $key_path"
  if [[ ! -e "$public_key_path" ]]; then
    ssh-keygen -y -f "$key_path" > "$public_key_path"
  fi
else
  echo "Using SSH key comment: $email"

  case "$key_type" in
    ed25519)
      ssh-keygen -t ed25519 -C "$email" -f "$key_path"
      ;;
    rsa)
      ssh-keygen -t rsa -b 4096 -C "$email" -f "$key_path"
      ;;
    *)
      echo "--type must be ed25519 or rsa." >&2
      exit 2
      ;;
  esac
fi

chmod 600 "$key_path"
chmod 644 "$public_key_path"
ensure_github_ssh_config "$key_path"

if [[ "$use_agent" -eq 1 ]]; then
  fingerprint="$(ssh-keygen -lf "$public_key_path" | awk '{print $2}')"
  if [[ -z "${SSH_AUTH_SOCK:-}" ]]; then
    eval "$(ssh-agent -s)" >/dev/null
  fi
  if agent_has_key "$fingerprint"; then
    echo "SSH key is already loaded in ssh-agent."
  else
    ssh-add "$key_path"
  fi
fi

ensure_github_key "$public_key_path" "$(hostname)-$key_name" "$key_path"
test_github_ssh "$key_path"

cat <<EOF

Public key:
$(cat "$public_key_path")

If it was not added automatically, add this public key in GitHub:
Settings -> SSH and GPG keys -> New SSH key

GitHub SSH authentication test passed.
EOF
