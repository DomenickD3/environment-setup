#!/usr/bin/env bash
set -euo pipefail

DEFAULT_REPO_URL="https://github.com/DomenickD3/environment-setup.git"
REPO_URL="${REPO_URL:-$DEFAULT_REPO_URL}"
DEFAULT_INSTALL_DIR="$HOME/.local/share/environment-setup"
DEFAULT_DOTFILES_REPO_URL="git@github.com:DomenickD3/.dotfiles.git"
DOTFILES_REPO_URL="${DOTFILES_REPO_URL:-$DEFAULT_DOTFILES_REPO_URL}"
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
DOTFILES_INSTALL_CMD="${DOTFILES_INSTALL_CMD:-}"
DEFAULT_DOTFILES_PRIVATE_REPO_URL="git@github.com:DomenickD3/.dotfiles-private.git"
DOTFILES_PRIVATE_REPO_URL="${DOTFILES_PRIVATE_REPO_URL:-$DEFAULT_DOTFILES_PRIVATE_REPO_URL}"
DOTFILES_PRIVATE_DIR="${DOTFILES_PRIVATE_DIR:-$HOME/.dotfiles-private}"
DOTFILES_PRIVATE_INSTALL_CMD="${DOTFILES_PRIVATE_INSTALL_CMD:-}"
SCRIPT_SOURCE="${BASH_SOURCE[0]:-}"
SCRIPT_DIR=""
if [[ -n "$SCRIPT_SOURCE" && -f "$SCRIPT_SOURCE" ]]; then
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
fi
if [[ -z "${INSTALL_DIR:-}" && -n "$SCRIPT_DIR" && -x "$SCRIPT_DIR/bin/install-nix" ]]; then
  INSTALL_DIR="$SCRIPT_DIR"
else
  INSTALL_DIR="${INSTALL_DIR:-$DEFAULT_INSTALL_DIR}"
fi
DRY_RUN=0

usage() {
  cat <<'USAGE'
Usage: install [script-name] [script-args...]

Clones or updates this repo into INSTALL_DIR.

With no script name, installs Nix if needed, installs Codex into your Nix
profile, along with GitHub CLI, Neovim, tmux, and stow, then runs the GitHub
SSH key setup, clones or updates your dotfiles, installs them, and prompts you
to log in to your Codex subscription.

Examples:
  curl -fsSL RAW_INSTALL_URL | bash
  curl -fsSL RAW_INSTALL_URL | bash -s -- --dry-run
  curl -fsSL RAW_INSTALL_URL | bash -s -- install-nix
  curl -fsSL RAW_INSTALL_URL | bash -s -- setup-github-ssh --help

Environment:
  REPO_URL       Git URL to clone. Default: https://github.com/DomenickD3/environment-setup.git
  INSTALL_DIR   Install location. Default: ~/.local/share/environment-setup
  DOTFILES_REPO_URL  Git URL for dotfiles. Default: git@github.com:DomenickD3/.dotfiles.git
  DOTFILES_DIR       Dotfiles checkout location. Default: ~/.dotfiles
  DOTFILES_INSTALL_CMD  Command to run inside the dotfiles checkout after syncing.
                        Default: auto-detect bootstrap/install/setup/script/install
  DOTFILES_PRIVATE_REPO_URL  Git URL for private dotfiles.
                        Default: git@github.com:DomenickD3/.dotfiles-private.git
  DOTFILES_PRIVATE_DIR  Private dotfiles checkout location. Default: ~/.dotfiles-private
  DOTFILES_PRIVATE_INSTALL_CMD  Command to run inside the private dotfiles checkout after syncing.
                        Default: auto-detect bootstrap/install/setup/script/install

Available scripts are discovered from INSTALL_DIR/bin after installation.
USAGE
}

fail() {
  echo "error: $*" >&2
  exit 1
}

section() {
  printf "\n==> %s\n\n" "$1"
}

load_nix_profile() {
  if command -v nix >/dev/null 2>&1; then
    return 0
  fi

  if [[ -r "$HOME/.nix-profile/etc/profile.d/nix.sh" ]]; then
    # shellcheck disable=SC1091
    . "$HOME/.nix-profile/etc/profile.d/nix.sh"
  elif [[ -r /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]]; then
    # shellcheck disable=SC1091
    . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
  fi
}

update_system_packages() {
  section "Update System Packages"

  if ! command -v apt-get >/dev/null 2>&1; then
    echo "apt-get is not available; skipping system package update."
    return 0
  fi

  sudo apt-get update
  sudo apt-get upgrade
}

codex_bin() {
  printf "%s/.nix-profile/bin/codex\n" "$HOME"
}

profile_bin() {
  printf "%s/.nix-profile/bin/%s\n" "$HOME" "$1"
}

install_profile_package() {
  local name="$1"
  local attr="$2"
  local binary="$3"
  local installed_binary

  installed_binary="$(profile_bin "$binary")"
  if [[ -x "$installed_binary" ]]; then
    echo "$name is already installed in your Nix profile:"
    "$installed_binary" --version
    return 0
  fi

  echo "Installing $name into your Nix profile..."
  nix --extra-experimental-features nix-command --extra-experimental-features flakes profile add "path:$INSTALL_DIR#$attr"
}

install_codex() {
  section "Install Codex"
  install_profile_package "Codex" "codex" "codex"
}

install_gh() {
  section "Install GitHub CLI"
  install_profile_package "GitHub CLI" "gh" "gh"
}

install_neovim() {
  section "Install Neovim"
  install_profile_package "Neovim" "neovim" "nvim"
}

install_tmux() {
  section "Install tmux"
  install_profile_package "tmux" "tmux" "tmux"
}

install_stow() {
  section "Install stow"
  install_profile_package "stow" "stow" "stow"
}

ensure_nix_profile_path() {
  local bashrc="$HOME/.bashrc"
  local profile_bin="$HOME/.nix-profile/bin"

  case ":$PATH:" in
    *":$profile_bin:"*) ;;
    *) export PATH="$profile_bin:$PATH" ;;
  esac

  if [[ -f "$bashrc" ]] && ! grep -Fq '.nix-profile/bin' "$bashrc"; then
    cat <<'EOF' >> "$bashrc"

# Prefer user-installed Nix binaries, including codex.
if [ -d "$HOME/.nix-profile/bin" ]; then
    export PATH="$HOME/.nix-profile/bin:$PATH"
fi
EOF
    echo "Added ~/.nix-profile/bin to $bashrc for future shells."
  fi
}

run_codex_login() {
  local installed_codex

  installed_codex="$(codex_bin)"
  [[ -x "$installed_codex" ]] || fail "codex is not installed at $installed_codex"

  if "$installed_codex" login status >/dev/null 2>&1; then
    echo "Codex is already authenticated."
    return 0
  fi

  echo
  echo "Starting Codex subscription login."
  "$installed_codex" login --device-auth
}

run_github_setup() {
  "$INSTALL_DIR/bin/setup-github-ssh"
}

dotfiles_install_command() {
  local repo_dir="$1"
  local install_cmd="${2:-}"

  if [[ -n "$install_cmd" ]]; then
    printf "%s\n" "$install_cmd"
    return 0
  fi

  local candidate
  for candidate in \
    "./bootstrap" \
    "./install" \
    "./setup" \
    "script/install"
  do
    if [[ -x "$repo_dir/$candidate" ]]; then
      printf "%s\n" "$candidate"
      return 0
    fi
  done

  return 1
}

sync_and_install_repo() {
  local section_name="$1"
  local repo_url="$2"
  local repo_dir="$3"
  local install_cmd_override="${4:-}"
  local install_cmd

  section "$section_name"

  if [[ -d "$repo_dir/.git" ]]; then
    echo "Using existing checkout: $repo_dir"
    git -C "$repo_dir" fetch --prune
    git -C "$repo_dir" pull --ff-only
  else
    echo "Cloning repo:"
    echo "  from: $repo_url"
    echo "  to:   $repo_dir"
    mkdir -p "$(dirname "$repo_dir")"
    git clone "$repo_url" "$repo_dir"
  fi

  install_cmd="$(dotfiles_install_command "$repo_dir" "$install_cmd_override")" || fail "could not find an install command in $repo_dir; set the matching *_INSTALL_CMD variable"

  echo "Running install command: $install_cmd"
  (
    cd "$repo_dir"
    eval "$install_cmd"
  )
}

install_dotfiles() {
  sync_and_install_repo "Dotfiles" "$DOTFILES_REPO_URL" "$DOTFILES_DIR" "$DOTFILES_INSTALL_CMD"
}

install_dotfiles_private() {
  sync_and_install_repo "Private Dotfiles" "$DOTFILES_PRIVATE_REPO_URL" "$DOTFILES_PRIVATE_DIR" "$DOTFILES_PRIVATE_INSTALL_CMD"
}

require_install_files() {
  local missing=()

  [[ -x "$INSTALL_DIR/bin/install-nix" ]] || missing+=("$INSTALL_DIR/bin/install-nix")
  [[ -x "$INSTALL_DIR/bin/setup-github-ssh" ]] || missing+=("$INSTALL_DIR/bin/setup-github-ssh")
  [[ -f "$INSTALL_DIR/flake.nix" ]] || missing+=("$INSTALL_DIR/flake.nix")

  if [[ "${#missing[@]}" -gt 0 ]]; then
    printf "error: install directory is incomplete: %s\n" "$INSTALL_DIR" >&2
    printf "missing: %s\n" "${missing[@]}" >&2
    exit 1
  fi
}

run_default_bootstrap() {
  if [[ "$DRY_RUN" -eq 1 ]]; then
    printf "sudo apt-get update\n"
    printf "sudo apt-get upgrade\n"
    "$INSTALL_DIR/bin/install-nix" --dry-run
    printf "nix --extra-experimental-features nix-command --extra-experimental-features flakes profile add %q\n" "path:$INSTALL_DIR#codex"
    printf "nix --extra-experimental-features nix-command --extra-experimental-features flakes profile add %q\n" "path:$INSTALL_DIR#gh"
    printf "nix --extra-experimental-features nix-command --extra-experimental-features flakes profile add %q\n" "path:$INSTALL_DIR#neovim"
    printf "nix --extra-experimental-features nix-command --extra-experimental-features flakes profile add %q\n" "path:$INSTALL_DIR#tmux"
    printf "nix --extra-experimental-features nix-command --extra-experimental-features flakes profile add %q\n" "path:$INSTALL_DIR#stow"
    printf "ensure %q is on PATH in the current shell and ~/.bashrc\n" "$HOME/.nix-profile/bin"
    printf "%q\n" "$INSTALL_DIR/bin/setup-github-ssh"
    if [[ -d "$DOTFILES_DIR/.git" ]]; then
      printf "git -C %q fetch --prune\n" "$DOTFILES_DIR"
      printf "git -C %q pull --ff-only\n" "$DOTFILES_DIR"
    else
      printf "git clone %q %q\n" "$DOTFILES_REPO_URL" "$DOTFILES_DIR"
    fi
    if install_cmd="$(dotfiles_install_command "$DOTFILES_DIR" "$DOTFILES_INSTALL_CMD")"; then
      printf "cd %q && %s\n" "$DOTFILES_DIR" "$install_cmd"
    else
      printf "# set DOTFILES_INSTALL_CMD to install dotfiles from %q\n" "$DOTFILES_DIR"
    fi
    if [[ -d "$DOTFILES_PRIVATE_DIR/.git" ]]; then
      printf "git -C %q fetch --prune\n" "$DOTFILES_PRIVATE_DIR"
      printf "git -C %q pull --ff-only\n" "$DOTFILES_PRIVATE_DIR"
    else
      printf "git clone %q %q\n" "$DOTFILES_PRIVATE_REPO_URL" "$DOTFILES_PRIVATE_DIR"
    fi
    if install_cmd="$(dotfiles_install_command "$DOTFILES_PRIVATE_DIR" "$DOTFILES_PRIVATE_INSTALL_CMD")"; then
      printf "cd %q && %s\n" "$DOTFILES_PRIVATE_DIR" "$install_cmd"
    else
      printf "# set DOTFILES_PRIVATE_INSTALL_CMD to install private dotfiles from %q\n" "$DOTFILES_PRIVATE_DIR"
    fi
    printf "%q login --device-auth\n" "$(codex_bin)"
    return 0
  fi

  update_system_packages
  section "Install Nix"
  "$INSTALL_DIR/bin/install-nix"
  load_nix_profile
  command -v nix >/dev/null 2>&1 || fail "nix is not available in this shell yet; open a new shell and rerun install"
  install_codex
  install_gh
  install_neovim
  install_tmux
  install_stow
  ensure_nix_profile_path
  section "GitHub SSH"
  "$INSTALL_DIR/install" "__github-setup"
  install_dotfiles
  install_dotfiles_private
  section "Codex Login"
  run_codex_login
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ "${1:-}" == "__github-setup" ]]; then
  run_github_setup
  exit 0
fi

if [[ "${1:-}" == "--dry-run" ]]; then
  DRY_RUN=1
  shift
fi

command -v git >/dev/null 2>&1 || fail "git is required"

if [[ -d "$INSTALL_DIR/.git" ]]; then
  if [[ "$INSTALL_DIR" == "$SCRIPT_DIR" ]]; then
    echo "Using local checkout: $INSTALL_DIR"
  else
    echo "Using existing install directory: $INSTALL_DIR"
  fi

  if git -C "$INSTALL_DIR" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    echo "Updating install directory from its configured upstream branch..."
    git -C "$INSTALL_DIR" fetch --prune
    git -C "$INSTALL_DIR" pull --ff-only
  else
    echo "No upstream branch is configured for this checkout; skipping git pull."
    echo "Set an upstream branch, such as origin/main, if you want this installer to self-update."
  fi
else
  echo "Cloning environment setup repo:"
  echo "  from: $REPO_URL"
  echo "  to:   $INSTALL_DIR"
  mkdir -p "$(dirname "$INSTALL_DIR")"
  git clone "$REPO_URL" "$INSTALL_DIR"
fi

require_install_files

if [[ $# -eq 0 ]]; then
  run_default_bootstrap
  exit 0
fi

script_name="$1"
shift

case "$script_name" in
  */*|"."|"..")
    fail "script name must be a command name from bin, not a path"
    ;;
esac

script_path="$INSTALL_DIR/bin/$script_name"

if [[ ! -x "$script_path" ]]; then
  echo "Available commands:" >&2
  find "$INSTALL_DIR/bin" -maxdepth 1 -type f -perm -u+x -printf '  %f\n' | sort >&2
  fail "unknown or non-executable script: $script_name"
fi

exec "$script_path" "$@"
